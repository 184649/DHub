<Window x:Class="ShortcutList.Views.QuickSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DHub" Width="780" Height="570" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="White" BorderBrush="#D7DCE2" BorderThickness="1" CornerRadius="12" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <TextBlock DockPanel.Dock="Right" Text="Enterで開く · Escで戻る" Foreground="#64748B" VerticalAlignment="Center"/>
                <TextBlock Text="開くものを選ぶ" FontSize="18" FontWeight="SemiBold"/>
            </DockPanel>
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <TextBox x:Name="SearchTextBox" Height="42" FontSize="18" VerticalContentAlignment="Center" TextChanged="SearchTextBox_TextChanged" AutomationProperties.Name="登録した名前や場所を検索"/>
                <TextBlock x:Name="SearchHint" Text="名前や場所で検索。入力せずに選べます" Margin="10,0" Foreground="#94A3B8" IsHitTestVisible="False" VerticalAlignment="Center"/>
            </Grid>
            <Border x:Name="AddPanel" Grid.Row="2" Visibility="Collapsed" Background="#EFF6FF" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="ファイル・フォルダー・URLを追加" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <DockPanel>
                        <Button x:Name="SaveTargetButton" DockPanel.Dock="Right" Content="保存" Click="SaveTargetButton_Click" Padding="14,5" Margin="8,0,0,0"/>
                        <TextBox x:Name="AddTargetTextBox" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="追加するパスまたはURL"/>
                    </DockPanel>
                    <TextBlock Text="追加中は他の画面へ切り替えても表示を保ちます。ドロップで登録、Escで終了。対象は開きません。" Foreground="#64748B" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Grid Grid.Row="3">
                <ListView x:Name="ResultListView" BorderThickness="0" MouseDoubleClick="ResultListView_MouseDoubleClick" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                            <Setter Property="Height" Value="Auto"/><Setter Property="MinHeight" Value="58"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4" ToolTip="{Binding TargetPath}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="102"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding FavoriteText}" Foreground="#D97706" FontSize="17" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding IconText}" FontSize="18" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="2" Margin="6,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding TargetPath}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="#64748B" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="{Binding KindDisplay}" IsEnabled="{Binding CanLaunch}" Click="OpenEntryButton_Click" Padding="6,5" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock x:Name="EmptyText" Text="ここへファイルやフォルダーをドロップするか、下の「追加」から登録できます。" Visibility="Collapsed" TextWrapping="Wrap" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#64748B"/>
            </Grid>
            <DockPanel Grid.Row="4" Margin="0,8,0,8">
                <Button x:Name="MoreButton" DockPanel.Dock="Right" Content="さらに表示" Visibility="Collapsed" Click="MoreButton_Click" Padding="10,4"/>
                <TextBlock x:Name="StatusText" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" MaxHeight="42"/>
            </DockPanel>
            <DockPanel Grid.Row="5">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="管理" Click="ManagementButton_Click" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="キー設定" Click="SettingsButton_Click" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="終了" Click="ExitButton_Click" Padding="10,5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button Content="追加" Click="AddButton_Click" Padding="14,5" Margin="0,0,5,0"/>
                    <Button Content="組合せを登録" Click="WorkspaceButton_Click" Padding="10,5" Margin="0,0,5,0"/>
                    <Button Content="再読込" Click="RefreshButton_Click" Padding="10,5"/>
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
